# ==========================================
# Variáveis de Ambiente - Frontend ScreenParty
# ==========================================

# URL base da API do backend ScreenParty para geração de tokens e salas
# Em desenvolvimento local:
#   VITE_API_URL=http://localhost:3001/api
#
# Em PRODUÇÃO (Cloudflare Pages):
#   VITE_API_URL=https://screenparty-api.onrender.com/api
#
# NOTA IMPORTANTE:
# - A URL DEVE terminar com /api.
# - Na build de produção, a aplicação NÃO recorre silenciosamente a localhost caso a variável falte.
# - NUNCA inclua chaves secretas ou LIVEKIT_API_SECRET no frontend!
VITE_API_URL=http://localhost:3001/api
