# ==========================================
# Variáveis de Ambiente - Backend ScreenParty
# ==========================================

# Ambiente de execução: development ou production
NODE_ENV=development

# Porta do servidor backend (o Render define PORT automaticamente)
PORT=3001

# Origens autorizadas no CORS
# Em produção (Render), insira a URL do Cloudflare Pages (ex: https://screenparty.pages.dev)
# Para múltiplos domínios, separe por vírgula: https://screenparty.pages.dev,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Credenciais do LiveKit Server (NUNCA EXPONHA NO FRONTEND)
# Em desenvolvimento local:
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secret
#   LIVEKIT_URL=ws://127.0.0.1:7880
#
# Em PRODUÇÃO (LiveKit Cloud):
#   LIVEKIT_API_KEY=APIxxxxxxxxx
#   LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# ATENÇÃO: Em produção (NODE_ENV=production), o backend FALHA na inicialização se
# LIVEKIT_API_KEY for 'devkey', LIVEKIT_API_SECRET for 'secret' ou a URL apontar para localhost.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://127.0.0.1:7880

# Tempo de vida dos tokens gerados em segundos (21600 = 6 horas)
TOKEN_TTL_SECONDS=21600
