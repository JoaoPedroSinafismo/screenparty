# Porta do servidor backend
PORT=3001

# Origens permitidas para CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173

# Credenciais do servidor LiveKit (NUNCA EXPONHA NO FRONTEND)
# Por padrão do LiveKit dev mode (livekit-server --dev):
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://127.0.0.1:7880

# Tempo de expiração do token em segundos (ex: 21600 = 6 horas)
TOKEN_TTL_SECONDS=21600

